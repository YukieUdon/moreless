{
  "name": "moreless",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, local-first toolkit for spending less and living more.",
  "license": "MIT",
  "author": "YukieUdon <https://github.com/YukieUdon>",
  "repository": {
    "type": "git",
